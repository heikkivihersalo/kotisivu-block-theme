#--------------------------------------------------------------------------------------------------#
#                                       ENVIRONMENT SETTING                                        #
#   It can be anything, but "development", "local" and "production" are supported out of the box.  #
#   Do not use "development" on production and viceversa, because it has effect on debug settings. #
#--------------------------------------------------------------------------------------------------#
APP_ENV="local"
APP_HOST=""

#--------------------------------------------------------------------------------------------------#
#                                      APPLICATION PASSWORDS                                       #
#    These are application passwords for debugging purposes. Passwords are only meant to work in   #
#   development environment. Don't add these to production code or add debug users to production.  #
#--------------------------------------------------------------------------------------------------#
ADMIN_APP_USERNAME=""
ADMIN_APP_PASSWORD=""

#--------------------------------------------------------------------------------------------------#
#                                       VITE DEVELOPMENT SERVER                                    #
#                              Hot Module Replacement (HMR) Configuration                           #
#                                                                                                  #
#   VITE_DEV_SERVER_HOST: The protocol and hostname for the dev server                             #
#   Examples:                                                                                      #
#     - http://localhost (for local development - port will be added automatically)                #
#     - https://block-theme.local (for Local by Flywheel - no port needed)                         #
#     - http://block-theme.test (for Valet - no port needed)                                       #
#     - http://block-theme.ddev.site (for DDEV - no port needed)                                   #
#                                                                                                  #
#   VITE_DEV_SERVER_PORT: The port number for the Vite dev server                                  #
#   Default: 5173                                                                                  #
#   Note: Port is only appended for localhost/IP addresses, not custom domains                     #
#   Certificates in Local (mac) can be found at:                                                    #
#     /Users/<USER>/Library/Application Support/Local/run/router/nginx/certs/                      #
#--------------------------------------------------------------------------------------------------#
VITE_SSL_KEY=""
VITE_SSL_CERT=""

#--------------------------------------------------------------------------------------------------#
#                                            API KEYS                                              #
#--------------------------------------------------------------------------------------------------#

#--------------------------------------------------------------------------------------------------#
#                                          MISCELLANEOUS                                           #
#--------------------------------------------------------------------------------------------------#
